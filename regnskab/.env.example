# Login til regnskabssystemet
REGNSKAB_USERNAME=admin
REGNSKAB_PASSWORD=

# Signeringsnøgle til login-cookies — sæt til noget tilfældigt og hemmeligt
SECRET_KEY=

# Anthropic API-nøgle — bruges til AI-læsning af leverandørfakturaer
ANTHROPIC_API_KEY=

# SQLite-database og upload-mappe (lokalt; på Railway peges disse på et Volume)
DB_PATH=regnskab.db
UPLOAD_DIR=uploads
